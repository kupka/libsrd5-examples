<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>Libsrd5Blazor</RootNamespace>
    <!-- No precompressed .br/.gz copies: GitHub Pages can't serve them, and they double the size of docs/blazor -->
    <CompressionEnabled>false</CompressionEnabled>
    <BlazorEnableCompression>false</BlazorEnableCompression>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="8.0.*" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="8.0.*" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- libsrd5 DLL built by CI from the version pinned in ../libsrd5.ref (same DLL in all examples). -->
    <Reference Include="libsrd5">
      <HintPath>lib/libsrd5.dll</HintPath>
    </Reference>
    <!-- Keep libsrd5 untrimmed when publishing. -->
    <TrimmerRootAssembly Include="libsrd5" />
  </ItemGroup>

</Project>

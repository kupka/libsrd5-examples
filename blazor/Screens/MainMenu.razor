@inherits ScreenBase

<img class="sprite" src="assets/UI-Background.png" style="@Layout.Rect(0, 0, 1050, 700)" />
<div class="text bottom" style="@Layout.Rect(-322.9279, -1, 370.832, 640)">@MenuText</div>
<div class="text" style="@Layout.Rect(199, 0.1397, 620, 640)">@MainText</div>
<NumButtons OnKey="KeyPressHandler" />
@if (library == null && menuArtVisible) {
    <img class="sprite pulse-slow" src="assets/sprites/logo.png" style="@Layout.Rect(177, -205, 512, 128)" />
    <img class="sprite" src="assets/sprites/wesnoth/dwarf_druid_attack.png" style="@Layout.Rect(-414, 70, 200, 200)" />
    <img class="sprite" src="assets/sprites/wesnoth/ogre_defend.png" style="@Layout.Rect(-235, 108, 250, 250)" />
} else if (library != null) {
    @* Category icon while the library is open *@
    <img class="sprite pixel" src="@("assets/sprites/library/library_" + library.Icon + ".png")" style="@Layout.Rect(-322, 210, 160, 160)" />
}

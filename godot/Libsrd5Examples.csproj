<Project Sdk="Godot.NET.Sdk/4.6.0">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <!-- Godot's Android export templates require .NET 9 -->
    <TargetFramework Condition=" '$(GodotTargetPlatform)' == 'android' ">net9.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>Libsrd5Examples</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- Same libsrd5 build (0.1.15, netstandard2.0) the Unity project ships with. -->
    <Reference Include="libsrd5">
      <HintPath>lib/libsrd5.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
